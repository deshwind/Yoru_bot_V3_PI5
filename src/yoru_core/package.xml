<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yoru_core</name>
  <version>1.0.0</version>
  <description>
    CCTV-triggered indoor rule-compliance robot: perception (YOLO), SORT tracking,
    multi-criteria event confirmation, CCTV-to-map coordinate transformation,
    Nav2 goal sending, escalation FSM, audio warnings, privacy-preserving
    incident logging, patrol and return-to-base behaviours.
  </description>
  <maintainer email="deshwind02@gmail.com">Deshwin Dharile</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- arduino_driver_node talks to the Nano Every over USB serial -->
  <exec_depend>python3-serial</exec_depend>
  <!-- NOT declared: python3-lgpio, needed only by the legacy direct-GPIO
       l298n_driver_node. lgpio replaces RPi.GPIO, which cannot work on the
       Pi 5 (GPIO now sits behind the RP1 southbridge, not on the SoC).
       setup_pi.sh installs it; the node degrades with a clear error if it
       is missing, so rosdep should not hard-fail a laptop build over it.
       The supported motor path is the Arduino bridge. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
