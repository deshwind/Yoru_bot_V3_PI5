<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yoru_base</name>
  <version>1.0.0</version>
  <description>Differential drive robot base: description, simulation, SLAM and Nav2 configs for the compliance robot project</description>
  <maintainer email="deshwind02@gmail.com">Deshwin Dharile</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>

  <!-- Lidar driver (real robot) -->
  <exec_depend>rplidar_ros</exec_depend>

  <!-- Joystick teleop -->
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <!-- Simulation: Gazebo Harmonic via ros_gz. Replaces gazebo_ros, which
       has no Jazzy release - Gazebo Classic went EOL in January 2025. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- NOTE: the Classic <gazebo_ros gazebo_model_path="..."/> export is
         gone. Harmonic ignores it; sim.launch.py appends the same directory
         to GZ_SIM_RESOURCE_PATH instead, which is how package://yoru_base/
         meshes/body_bot.stl still resolves. -->
  </export>
</package>
