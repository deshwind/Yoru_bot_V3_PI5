# Stable device names for the Yoru robot's USB peripherals.
# Installed to /etc/udev/rules.d/ by setup_pi.sh.
#
# WHY: V2 addressed the lidar by USB by-path:
#     /dev/serial/by-path/platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.1:1.0-port0
# That string encodes the Pi 4's PCIe controller address. The Pi 5 uses a
# different SoC with a different PCIe layout (and an RP1 southbridge), so the
# path does not exist and the lidar node dies at startup. Matching on the
# USB vendor/product ID instead is stable across board revisions AND across
# which physical port you happen to plug into.
#
# Check what you actually have:
#     udevadm info -a -n /dev/ttyUSB0 | grep -E 'idVendor|idProduct|serial'
#
# After editing:
#     sudo udevadm control --reload-rules && sudo udevadm trigger

# --- RPLIDAR A1 -------------------------------------------------------------
# The A1's USB bridge is a Silicon Labs CP2102 (10c4:ea60).
# NOTE: the CP2102 is a generic bridge used by many devices. If you ever add
# a second CP2102 device, disambiguate by appending the serial number, e.g.
#     ATTRS{serial}=="0001", SYMLINK+="rplidar"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
    MODE:="0666", GROUP:="dialout", SYMLINK+="rplidar"

# --- Arduino Nano Every (motor bridge) --------------------------------------
# Official Nano Every: 2341:0058. Enumerates as /dev/ttyACM*.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0058", \
    MODE:="0666", GROUP:="dialout", SYMLINK+="arduino"

# Clone / CH340-based Nano boards, in case the Nano Every is swapped out.
# Commented off by default so it cannot fight the rule above.
#SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
#    MODE:="0666", GROUP:="dialout", SYMLINK+="arduino"
